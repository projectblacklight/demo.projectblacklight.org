# Secrets defined here are available for reference under registry/password, env/secret, builder/secrets,
# and accessories/*/env/secret in config/deploy.yml. All secrets should be pulled from either
# password manager, ENV, or a file. DO NOT ENTER RAW CREDENTIALS HERE! This file needs to be safe for git.

# A GitHub personal access token (classic) with write:packages scope, used to push/pull images on ghcr.io.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# Requires `vault login -method oidc`.
SECRET_KEY_BASE=$(vault kv get -field=content puppet/application/demo.projectblacklight.org/secret_key_base)
HONEYBADGER_API_KEY=$(vault kv get -field=content puppet/application/demo.projectblacklight.org/honeybadger_api_key)
